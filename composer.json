{
    "name": "generoi/gds-content-translation",
    "type": "wordpress-plugin",
    "license": "MIT",
    "description": "Polylang Pro helpers for block translation rules, link remapping, and editorial translation status",
    "homepage": "https://github.com/generoi/gds-content-translation",
    "authors": [
        {
            "name": "Genero",
            "email": "info@genero.fi"
        }
    ],
    "require": {
        "php": ">=8.0.0"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "phpunit/phpunit": "^9.0",
        "wp-phpunit/wp-phpunit": "^7.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GeneroWP\\ContentTranslation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeneroWP\\ContentTranslation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "test": "phpunit",
        "test:wp-env": "wp-env run tests-cli --env-cwd=wp-content/plugins/gds-content-translation vendor/bin/phpunit",
        "build:production": "@composer install --optimize-autoloader --no-dev"
    }
}
